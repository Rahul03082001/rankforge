FROM node:22-bookworm-slim AS frontend
WORKDIR /web
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

# Cloud Run uses Linux AMD64. Use the official CPU distributions so that
# serving this CPU-only model does not pull CUDA or NVIDIA runtime packages.
FROM python:3.11-slim-bookworm AS dependencies
RUN apt-get update && apt-get install -y --no-install-recommends g++ libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements.lock /tmp/requirements.lock
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --no-deps torch==2.6.0+cpu --index-url https://download.pytorch.org/whl/cpu \
    && sed 's/^xgboost==/xgboost-cpu==/' /tmp/requirements.lock > /tmp/requirements.cpu.lock \
    && /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements.cpu.lock \
    && /opt/venv/bin/pip check

FROM python:3.11-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/* && useradd -m -u 1000 app
COPY --from=dependencies /opt/venv /opt/venv
WORKDIR /app
COPY backend /app/backend
COPY docs/DATA.md LICENSE /app/notices/
COPY --from=frontend /web/dist /app/frontend/dist
COPY --chown=app:app release/bundle /app/artifacts/fiqa-ltr
COPY --chown=app:app release/reports /app/reports
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/app/backend RANKFORGE_BUNDLE=/app/artifacts/fiqa-ltr OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false HF_HUB_OFFLINE=1 PORT=8080
USER app
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s CMD python -c "import urllib.request,os;urllib.request.urlopen('http://localhost:'+os.getenv('PORT','8080')+'/health/ready')"
CMD ["sh", "-c", "exec uvicorn rankforge.api:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
