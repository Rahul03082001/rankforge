FROM python:3.11-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends g++ libgomp1 curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
ENV PYTHONPATH=/app/backend OMP_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false HF_HOME=/app/.cache/huggingface
CMD ["python", "-m", "rankforge.cli", "--help"]
